<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stitching Job Work Tracker - TextileHub Erode</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #0f172a;
            --panel: #1e293b;
            --border: #334155;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --brand: #0284c7;
            --gold: #f59e0b;
            --success: #10b981;
            --radius: 18px;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', sans-serif; }
        body { background: var(--bg); color: var(--text-main); line-height: 1.5; padding-bottom: 80px; }

        .header { background: rgba(30, 41, 59, 0.85); backdrop-filter: blur(16px); border-bottom: 1px solid var(--border); padding: 1.1rem 2rem; display: flex; justify-content: space-between; align-items: center; }
        .logo { font-size: 1.3rem; font-weight: 800; color: #38bdf8; text-decoration: none; }
        .logo span { color: var(--gold); }

        .container { max-width: 720px; margin: 3rem auto; padding: 0 1.5rem; display: flex; flex-direction: column; gap: 2rem; }

        .search-card { background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); padding: 2rem; display: flex; flex-direction: column; gap: 1rem; box-shadow: 0 20px 40px rgba(0,0,0,0.3); }
        .search-title { font-size: 1.3rem; font-weight: 800; color: white; text-align: center; }
        
        .search-box { display: flex; gap: 0.5rem; }
        .search-input { flex: 1; padding: 0.85rem 1.1rem; border-radius: 12px; border: 1px solid var(--border); background: #0f172a; color: white; font-size: 1rem; font-weight: 700; text-transform: uppercase; }
        .search-input:focus { outline: none; border-color: var(--brand); }
        
        .btn-search { background: var(--brand); color: white; border: none; padding: 0.85rem 1.5rem; border-radius: 12px; font-weight: 800; font-size: 0.95rem; cursor: pointer; }
        .btn-search:hover { background: #0369a1; }

        /* TICKET RESULTS CARD */
        .result-card { background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); padding: 2rem; display: none; flex-direction: column; gap: 1.5rem; }

        .pipeline { display: flex; justify-content: space-between; position: relative; margin: 2rem 0 1rem; }
        .pipeline::before { content: ''; position: absolute; top: 18px; left: 10%; right: 10%; height: 4px; background: var(--border); z-index: 1; }
        
        .pipe-step { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; flex: 1; }
        .pipe-dot { width: 38px; height: 38px; border-radius: 50%; background: #0f172a; border: 3px solid var(--border); display: flex; justify-content: center; align-items: center; font-size: 1rem; font-weight: 800; color: var(--text-muted); transition: all 0.3s; }
        .pipe-label { font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-align: center; }

        .pipe-step.done .pipe-dot { background: var(--success); border-color: var(--success); color: white; box-shadow: 0 0 15px rgba(16, 185, 129, 0.5); }
        .pipe-step.done .pipe-label { color: var(--success); }

        .pipe-step.active .pipe-dot { background: var(--brand); border-color: #38bdf8; color: white; box-shadow: 0 0 20px var(--brand); animation: pulse 1.5s infinite; }
        .pipe-step.active .pipe-label { color: #38bdf8; font-weight: 800; }
        @keyframes pulse { 0% { transform: scale(1); } 50% { transform: scale(1.1); } 100% { transform: scale(1); } }

        .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; background: rgba(255,255,255,0.04); padding: 1.25rem; border-radius: 12px; border: 1px solid var(--border); font-size: 0.9rem; }
        .info-label { color: var(--text-muted); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; }
        .info-val { font-weight: 700; color: white; margin-top: 0.2rem; }
    </style>
</head>
<body>

    <div class="header">
        <a href="/" class="logo">🧶 TextileHub <span>Erode</span></a>
        <a href="/" style="color:#38bdf8; font-weight:700; text-decoration:none;">← Back to Catalog</a>
    </div>

    <div class="container">
        <div class="search-card">
            <h2 class="search-title">🧵 Stitching & Tailoring Job Work Tracker</h2>
            <p style="color:var(--text-muted); font-size:0.85rem; text-align:center;">Enter your Job Ticket Number to check live stitching & delivery status</p>
            
            <div class="search-box">
                <input type="text" id="ticketInput" class="search-input" placeholder="e.g. JOB-88410" value="JOB-88410">
                <button class="btn-search" onclick="trackJob()">Check Status</button>
            </div>
            <div id="errorMsg" style="color:#fca5a5; font-size:0.85rem; text-align:center; display:none;"></div>
        </div>

        <div class="result-card" id="resultCard">
            <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border); padding-bottom:1rem;">
                <div>
                    <h3 style="font-size:1.3rem; font-weight:800; color:#38bdf8;" id="resTicketNo">JOB-88410</h3>
                    <p style="font-size:0.8rem; color:var(--text-muted);" id="resClient">Sri Krishna Garments (CBE)</p>
                </div>
                <span id="resStatusBadge" style="background:#0284c7; color:white; padding:0.4rem 1rem; border-radius:999px; font-size:0.8rem; font-weight:800; text-transform:uppercase;">STITCHING</span>
            </div>

            <!-- VISUAL PIPELINE -->
            <div class="pipeline">
                <div class="pipe-step" id="stepInward">
                    <div class="pipe-dot">📦</div>
                    <div class="pipe-label">Fabric Inward</div>
                </div>
                <div class="pipe-step" id="stepCutting">
                    <div class="pipe-dot">✂️</div>
                    <div class="pipe-label">Cutting</div>
                </div>
                <div class="pipe-step" id="stepStitching">
                    <div class="pipe-dot">🧵</div>
                    <div class="pipe-label">Stitching</div>
                </div>
                <div class="pipe-step" id="stepQuality">
                    <div class="pipe-dot">🔍</div>
                    <div class="pipe-label">Quality Check</div>
                </div>
                <div class="pipe-step" id="stepDispatched">
                    <div class="pipe-dot">🚚</div>
                    <div class="pipe-label">Dispatched</div>
                </div>
            </div>

            <div class="info-grid">
                <div>
                    <div class="info-label">Garment & Order Details</div>
                    <div class="info-val" id="resGarment">500 Sets School Uniform</div>
                </div>
                <div>
                    <div class="info-label">Inward Fabric Length</div>
                    <div class="info-val" id="resFabric">1200 Meters Fabric</div>
                </div>
                <div>
                    <div class="info-label">Client Phone</div>
                    <div class="info-val" id="resPhone">9842101234</div>
                </div>
                <div>
                    <div class="info-label">Estimated Delivery</div>
                    <div class="info-val" id="resDelivery" style="color:var(--gold);">2026-08-05</div>
                </div>
            </div>
        </div>
    </div>

<script>
    async function trackJob() {
        const ticket = document.getElementById('ticketInput').value;
        const errBox = document.getElementById('errorMsg');
        const resCard = document.getElementById('resultCard');
        errBox.style.display = 'none';

        if (!ticket) return;

        try {
            const res = await fetch(`/api/v1/jobs/track/${encodeURIComponent(ticket)}`);
            const data = await res.json();

            if (!res.ok) throw new Error(data.message || 'Ticket not found');

            const job = data.data;
            document.getElementById('resTicketNo').textContent = job.job_ticket_number;
            document.getElementById('resClient').textContent = job.client_name;
            document.getElementById('resGarment').textContent = `${job.quantity} Pcs - ${job.garment_type}`;
            document.getElementById('resFabric').textContent = job.fabric_inward_length || 'N/A';
            document.getElementById('resPhone').textContent = job.client_phone;
            document.getElementById('resDelivery').textContent = job.estimated_delivery || 'To be updated';
            document.getElementById('resStatusBadge').textContent = (job.status || 'pending').replace('_', ' ');

            // Update Pipeline Steps
            const status = String(job.status || '').toLowerCase();
            updatePipeline(status);

            resCard.style.display = 'flex';
        } catch (err) {
            resCard.style.display = 'none';
            errBox.textContent = err.message;
            errBox.style.display = 'block';
        }
    }

    function updatePipeline(status) {
        const steps = ['Inward', 'Cutting', 'Stitching', 'Quality', 'Dispatched'];
        const statusMap = {
            'inward_received': 0,
            'cutting': 1,
            'stitching': 2,
            'quality_check': 3,
            'packing': 3,
            'dispatched': 4
        };

        const activeIdx = statusMap[status] !== undefined ? statusMap[status] : 0;

        steps.forEach((st, idx) => {
            const el = document.getElementById(`step${st}`);
            el.className = 'pipe-step';
            if (idx < activeIdx) el.classList.add('done');
            if (idx === activeIdx) el.classList.add(status === 'dispatched' ? 'done' : 'active');
        });
    }

    // Auto-track default on load
    trackJob();
</script>
</body>
</html>
