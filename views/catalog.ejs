    function sendWhatsAppMessage() {
        const qty = document.getElementById('orderQty').value || 1;
        const buyer = document.getElementById('buyerInfo').value || 'Buyer';
        const phone = activeItem.whatsapp || '916374428155';

        const msg = `*NEW TEXTILE ORDER ENQUIRY*%0A%0A` +
                    `*Product:* ${encodeURIComponent(activeItem.name)}%0A` +
                    `*Code:* ${encodeURIComponent(activeItem.code)}%0A` +
                    `*Rate:* ₹${activeItem.price}%0A` +
                    `*Quantity:* ${qty} Pcs/Meters%0A` +
                    `*Buyer Info:* ${encodeURIComponent(buyer)}%0A%0A` +
                    `_Sent via TextileHub Erode Digital Catalog_`;

        window.open(`https://wa.me/${phone}?text=${msg}`, '_blank');
        closeModal();
    }

    async function trackJob() {
        const ticket = document.getElementById('ticketInput').value;
        const errBox = document.getElementById('errorMsg');
        const resCard = document.getElementById('resultCard');
        errBox.style.display = 'none';

        if (!ticket) return;

        try {
            const res = await fetch(`/api/v1/jobs/track/${encodeURIComponent(ticket)}`);
            const data = await res.json();

            if (!res.ok) throw new Error(data.message || 'Ticket not found');

            const job = data.data;
            document.getElementById('resTicketNo').textContent = job.job_ticket_number;
            document.getElementById('resClient').textContent = job.client_name;
            document.getElementById('resGarment').textContent = `${job.quantity} Pcs - ${job.garment_type}`;
            document.getElementById('resFabric').textContent = job.fabric_inward_length || 'N/A';
            document.getElementById('resPhone').textContent = job.client_phone;
            document.getElementById('resDelivery').textContent = job.estimated_delivery || 'To be updated';
            
            const displayStatus = job.status === 'dispatched' ? (currentLang === 'ta' ? 'டெலிவரிக்கு தயார்' : 'READY FOR DELIVERY') : (job.status || 'pending').replace('_', ' ');
            document.getElementById('resStatusBadge').textContent = displayStatus;

            const status = String(job.status || '').toLowerCase();
            updatePipeline(status);

            resCard.style.display = 'flex';
        } catch (err) {
            resCard.style.display = 'none';
            errBox.textContent = err.message;
            errBox.style.display = 'block';
        }
    }

    function updatePipeline(status) {
        const steps = ['Inward', 'Cutting', 'Stitching', 'Quality', 'Dispatched'];
        const statusMap = {
            'inward_received': 0,
            'cutting': 1,
            'stitching': 2,
            'quality_check': 3,
            'packing': 3,
            'dispatched': 4
        };

        const activeIdx = statusMap[status] !== undefined ? statusMap[status] : 0;

        steps.forEach((st, idx) => {
            const el = document.getElementById(`step${st}`);
            el.className = 'pipe-step';
            if (idx < activeIdx) el.classList.add('done');
            if (idx === activeIdx) el.classList.add(status === 'dispatched' ? 'done' : 'active');
        });
    }

