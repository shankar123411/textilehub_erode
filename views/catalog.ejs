<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TextileHub Erode - Enterprise Textile & Garment Portal</title>
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" type="image/png" href="/icons/logo.png">
    <meta name="theme-color" content="#08080a">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,400;0,600;0,700;1,400&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #08080a;
            --panel: #121216;
            --panel-card: #18181f;
            --border: #26262e;
            --border-gold: #d4af37;
            --text-main: #ffffff;
            --text-muted: #a1a1aa;
            --gold: #d4af37;
            --gold-light: #f3c846;
            --gold-glow: rgba(212, 175, 55, 0.25);
            --red-glow: rgba(220, 38, 38, 0.4);
            --red-bg: #991b1b;
            --red-bright: #ef4444;
            --whatsapp: #25d366;
            --radius: 16px;
            --font-head: 'Oswald', sans-serif;
            --font-body: 'Open Sans', sans-serif;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: var(--font-body); }
        body { background: var(--bg); color: var(--text-main); line-height: 1.5; padding-bottom: 80px; }

        h1, h2, h3, h4, h5, .font-head { font-family: var(--font-head); text-transform: uppercase; letter-spacing: 0.5px; }

        /* HEADER NAV */
        .header { background: rgba(18, 18, 22, 0.95); backdrop-filter: blur(16px); border-bottom: 1px solid var(--border); padding: 1.1rem 2.25rem; position: sticky; top: 0; z-index: 100; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; }
        .logo { font-family: var(--font-head); font-size: 1.6rem; font-weight: 700; color: #ffffff; display: flex; align-items: center; gap: 0.75rem; text-decoration: none; letter-spacing: 1px; }
        .logo span { color: var(--gold); }
        .logo-img { width: 44px; height: 44px; border-radius: 50%; border: 2px solid var(--gold); box-shadow: 0 0 15px var(--gold-glow); object-fit: cover; }

        .header-actions { display: flex; align-items: center; gap: 1rem; }

        .nav-tabs { display: flex; gap: 0.4rem; background: #000000; padding: 0.3rem; border-radius: 999px; border: 1px solid var(--border); }
        .tab-btn { background: transparent; color: var(--text-muted); border: none; padding: 0.5rem 1.1rem; border-radius: 999px; font-weight: 700; font-size: 0.85rem; cursor: pointer; display: flex; align-items: center; gap: 0.4rem; transition: all 0.25s ease; }
        .tab-btn svg { width: 16px; height: 16px; fill: currentColor; }
        .tab-btn:hover { color: var(--gold); }
        .tab-btn.active { background: var(--gold); color: #000000; font-weight: 800; box-shadow: 0 4px 15px var(--gold-glow); }

        .lang-btn { background: #18181f; color: var(--gold); border: 1px solid var(--gold); padding: 0.45rem 1rem; border-radius: 999px; font-weight: 800; font-size: 0.85rem; cursor: pointer; display: flex; align-items: center; gap: 0.4rem; transition: all 0.2s; }
        .lang-btn:hover { background: var(--gold); color: black; }
        .lang-btn svg { width: 16px; height: 16px; fill: currentColor; }

        .pwa-banner { background: linear-gradient(90deg, #18181f, #121216); border-bottom: 1px solid var(--gold); padding: 0.65rem 1.5rem; display: none; justify-content: space-between; align-items: center; font-size: 0.85rem; }
        .btn-install { background: var(--gold); color: black; border: none; padding: 0.35rem 1rem; border-radius: 999px; font-weight: 800; font-size: 0.8rem; cursor: pointer; }

        /* VIEW CONTAINERS */
        .page-view { display: none; }
        .page-view.active { display: block; }

        /* HERO & FILTER */
        .hero { text-align: center; padding: 3rem 1.5rem 1.5rem; max-width: 850px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 1rem; }
        .hero-logo-img { width: 90px; height: 90px; border-radius: 50%; border: 3px solid var(--gold); box-shadow: 0 0 25px var(--gold-glow); }
        .hero h1 { font-size: 2.7rem; font-weight: 700; color: #ffffff; line-height: 1.15; }
        .hero h1 span { color: var(--gold); }
        .hero p { color: var(--text-muted); font-size: 0.95rem; }

        .categories { display: flex; justify-content: center; gap: 0.6rem; overflow-x: auto; padding: 1rem 1.5rem; scrollbar-width: none; flex-wrap: wrap; }
        .cat-chip { background: #121216; border: 1px solid var(--border); color: var(--text-muted); padding: 0.6rem 1.4rem; border-radius: 999px; font-size: 0.85rem; font-weight: 700; cursor: pointer; white-space: nowrap; transition: all 0.2s; }
        .cat-chip:hover, .cat-chip.active { background: var(--gold); color: #000000; border-color: var(--gold); font-weight: 800; box-shadow: 0 4px 15px var(--gold-glow); }

        /* PRODUCTS GRID */
        .container { max-width: 1280px; margin: 1.5rem auto; padding: 0 1.5rem; }
        .products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 1.75rem; }

        .product-card { background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; transition: all 0.25s ease; }
        .product-card:hover { transform: translateY(-5px); border-color: var(--gold); box-shadow: 0 15px 35px rgba(212, 175, 55, 0.15); }

        .card-img-wrap { position: relative; height: 230px; width: 100%; overflow: hidden; background: #000000; }
        .card-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
        .product-card:hover .card-img-wrap img { transform: scale(1.06); }

        .badge-cat { position: absolute; top: 14px; left: 14px; background: rgba(0,0,0,0.85); backdrop-filter: blur(8px); border: 1px solid var(--gold); color: var(--gold); font-family: var(--font-head); font-size: 0.75rem; font-weight: 700; padding: 0.25rem 0.75rem; border-radius: 999px; letter-spacing: 0.5px; }

        .card-body { padding: 1.25rem; display: flex; flex-direction: column; gap: 0.75rem; flex: 1; justify-content: space-between; }
        .product-title { font-size: 1.25rem; font-weight: 700; color: #ffffff; line-height: 1.25; }
        .product-desc { font-size: 0.85rem; color: var(--text-muted); line-height: 1.45; }

        .specs-list { display: flex; flex-wrap: wrap; gap: 0.4rem; font-size: 0.75rem; color: #d4d4d8; }
        .spec-tag { background: #18181f; padding: 0.25rem 0.6rem; border-radius: 6px; border: 1px solid var(--border); }

        .price-row { display: flex; justify-content: space-between; align-items: center; border-top: 1px dashed var(--border); padding-top: 0.85rem; margin-top: 0.5rem; }
        .price-val { font-family: var(--font-head); font-size: 1.45rem; font-weight: 700; color: var(--gold); }
        .price-type { font-size: 0.75rem; color: var(--text-muted); font-weight: 600; }

        .btn-whatsapp { background: var(--gold); color: #000000; font-weight: 800; border: none; padding: 0.8rem 1.2rem; border-radius: 12px; font-size: 0.9rem; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.5rem; text-decoration: none; width: 100%; transition: all 0.2s; box-shadow: 0 4px 15px var(--gold-glow); }
        .btn-whatsapp:hover { background: var(--gold-light); transform: translateY(-2px); box-shadow: 0 6px 20px rgba(243, 200, 70, 0.4); }

        /* JOB TRACKER STYLES */
        .search-card { background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); padding: 2.5rem 2rem; display: flex; flex-direction: column; gap: 1.25rem; max-width: 680px; margin: 2rem auto; box-shadow: 0 20px 40px rgba(0,0,0,0.5); }
        .search-input { flex: 1; padding: 0.85rem 1.1rem; border-radius: 12px; border: 1px solid var(--border); background: #000000; color: white; font-size: 1rem; font-weight: 700; text-transform: uppercase; }
        .search-input:focus { outline: none; border-color: var(--gold); }

        .pipeline { display: flex; justify-content: space-between; position: relative; margin: 2.5rem 0 1rem; }
        .pipeline::before { content: ''; position: absolute; top: 18px; left: 10%; right: 10%; height: 3px; background: var(--border); z-index: 1; }
        
        .pipe-step { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; gap: 0.6rem; flex: 1; }
        .pipe-dot { width: 40px; height: 40px; border-radius: 50%; background: #08080a; border: 2px solid var(--border); display: flex; justify-content: center; align-items: center; fill: var(--text-muted); transition: all 0.3s; }
        .pipe-dot svg { width: 18px; height: 18px; }
        .pipe-label { font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-align: center; }

        .pipe-step.done .pipe-dot { background: var(--gold); border-color: var(--gold); fill: #000000; box-shadow: 0 0 15px var(--gold-glow); }
        .pipe-step.done .pipe-label { color: var(--gold); font-weight: 700; }

        .pipe-step.active .pipe-dot { background: #ffffff; border-color: var(--gold); fill: #000000; box-shadow: 0 0 20px rgba(255,255,255,0.8); }
        .pipe-step.active .pipe-label { color: #ffffff; font-weight: 800; }

        .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; background: #08080a; padding: 1.25rem; border-radius: 12px; border: 1px solid var(--border); font-size: 0.85rem; }

        /* ADMIN LOGIN MODAL BOX */
        .login-box { background: var(--panel); border: 1px solid var(--gold); border-radius: var(--radius); padding: 2.5rem; width: 100%; max-width: 400px; margin: 3rem auto; display: flex; flex-direction: column; gap: 1.5rem; box-shadow: 0 25px 50px rgba(0,0,0,0.8); }
        .login-box h2 { font-size: 1.5rem; font-weight: 700; color: var(--gold); }

        .password-wrap { position: relative; display: flex; align-items: center; }
        .password-wrap input { width: 100%; padding-right: 2.8rem; }
        .eye-btn { position: absolute; right: 10px; background: none; border: none; color: var(--text-muted); cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 4px; }
        .eye-btn:hover { color: var(--gold); }

        /* ADMIN PANEL STYLES */
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; }
        .stat-card { background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.5rem; display: flex; flex-direction: column; gap: 0.4rem; }
        .stat-val { font-family: var(--font-head); font-size: 2.2rem; font-weight: 700; color: var(--gold); }

        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
        @media (max-width: 880px) { .grid-2 { grid-template-columns: 1fr; } }

        .card-panel { background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.75rem; display: flex; flex-direction: column; gap: 1.25rem; }
        .form-group { display: flex; flex-direction: column; gap: 0.35rem; }
        .form-group label { font-size: 0.8rem; font-weight: 700; color: var(--text-muted); }
        .form-input { padding: 0.7rem 0.9rem; border: 1px solid var(--border); border-radius: 8px; background: #000000; color: white; font-size: 0.9rem; }
        .form-input:focus { outline: none; border-color: var(--gold); }

        .table-wrap { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
        th { background: #08080a; padding: 0.75rem 1rem; text-align: left; font-family: var(--font-head); font-weight: 700; color: var(--gold); border-bottom: 1px solid var(--border); letter-spacing: 0.5px; }
        td { padding: 0.75rem 1rem; border-bottom: 1px solid var(--border); color: white; }

        /* STATUS BADGES WITH RED GLOW FOR READY FOR DELIVERY */
        .tag-status { display: inline-block; padding: 0.35rem 0.9rem; border-radius: 999px; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; }
        .tag-status.inward_received { background: #3f3f46; color: #f4f4f5; }
        .tag-status.cutting, .tag-status.stitching { background: #713f12; color: #fef08a; }
        .tag-status.quality_check, .tag-status.packing { background: #854d0e; color: #fef9c3; }
        .tag-status.dispatched { background: #dc2626; color: #ffffff; box-shadow: 0 0 15px var(--red-glow); font-weight: 800; border: 1px solid #ef4444; }

        .lbl-dispatched-tag { color: #ef4444; font-weight: 800; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; }

        .btn-del-prod { background: #dc2626; color: white; border: none; padding: 0.4rem 0.8rem; border-radius: 6px; font-weight: 700; font-size: 0.75rem; cursor: pointer; transition: all 0.2s; }
        .btn-del-prod:hover { background: #ef4444; box-shadow: 0 0 10px var(--red-glow); }

        /* MODAL */
        .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.85); backdrop-filter: blur(12px); display: none; justify-content: center; align-items: center; z-index: 200; padding: 1rem; }
        .order-modal { background: var(--panel); border: 1px solid var(--gold); border-radius: 24px; padding: 2rem; width: 100%; max-width: 440px; display: flex; flex-direction: column; gap: 1.25rem; color: white; box-shadow: 0 25px 50px rgba(0,0,0,0.8); }
    </style>
</head>
<body>

    <div class="pwa-banner" id="pwaBanner">
        <span id="pwaBannerText">Install TextileHub App on Mobile Home Screen</span>
        <button class="btn-install" id="installBtn">Install App</button>
    </div>

    <!-- MAIN HEADER NAV WITH ERODE KAALA MAADU BULL LOGO -->
    <div class="header">
        <a href="#" class="logo" onclick="switchTab('catalogView')">
            <img src="/icons/logo.png" alt="Erode Bull Logo" class="logo-img">
            <span>TEXTILEHUB</span> <span id="logoCity">ERODE</span>
        </a>

        <div class="header-actions">
            <!-- SVG LANGUAGE TOGGLE BUTTON (NO EMOJI) -->
            <button class="lang-btn" onclick="toggleLanguage()" id="langBtn">
                <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
                <span id="txtLangLabel">Tamil (தமிழ்)</span>
            </button>

            <!-- TAB NAVIGATION WITH SVG SYMBOLS (NO EMOJIS) -->
            <div class="nav-tabs">
                <button class="tab-btn active" id="btnTabCatalog" onclick="switchTab('catalogView')">
                    <svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zm-7-2h5v-2h-5v2zm0-4h5v-2h-5v2zm0-4h5V7h-5v2zM7 7h3v10H7V7z"/></svg>
                    <span id="txtTabCatalog">Digital Catalog</span>
                </button>
                <button class="tab-btn" id="btnTabTrack" onclick="switchTab('trackerView')">
                    <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.2 3.2.8-1.3-4.5-2.7V7z"/></svg>
                    <span id="txtTabTrack">Job Work Tracker</span>
                </button>
                <button class="tab-btn" id="btnTabAdmin" onclick="switchTab('adminView')">
                    <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-5.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8subscriptionz"/></svg>
                    <span id="txtTabAdmin">Merchant Control</span>
                </button>
            </div>
        </div>
    </div>

    <!-- PAGE 1: DIGITAL CATALOG VIEW -->
    <div class="page-view active" id="catalogView">
        <div class="hero">
            <img src="/icons/logo.png" alt="Erode Kaala Maadu Emblem" class="hero-logo-img">
            <h1 id="heroTitle">TEXTILEHUB <span>ERODE</span></h1>
            <p id="heroSubtitle">Erode Wholesale Soft Silk Sarees, Shirtings, Nighties & Custom Garment Stitching</p>
        </div>

        <div class="categories">
            <button class="cat-chip active" id="catAll" onclick="filterCategory('all', this)">All Collections</button>
            <button class="cat-chip" id="cat1" onclick="filterCategory(1, this)">Silk & Soft Sarees</button>
            <button class="cat-chip" id="cat2" onclick="filterCategory(2, this)">Linen & Cotton Shirtings</button>
            <button class="cat-chip" id="cat3" onclick="filterCategory(3, this)">Tailoring Job Work</button>
            <button class="cat-chip" id="cat4" onclick="filterCategory(4, this)">Nighties & Home</button>
            <button class="cat-chip" id="cat5" onclick="filterCategory(5, this)">Uniforms</button>
        </div>

        <div class="container">
            <div class="products-grid" id="productsGrid">
                <% products.forEach(function(item, idx) { %>
                    <div class="product-card" data-cat="<%= item.category_id || 1 %>" data-id="<%= item.id %>" id="card-<%= item.id %>">
                        <div>
                            <div class="card-img-wrap">
                                <span class="badge-cat badge-cat-txt" data-en="<%= item.category_name || 'TEXTILE' %>"><%= item.category_name || 'TEXTILE' %></span>
                                <img src="<%= item.image_url || 'https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=600' %>" alt="<%= item.name %>" loading="lazy">
                            </div>
                            <div class="card-body">
                                <div>
                                    <h3 class="product-title card-p-title" data-en="<%= item.name %>"><%= item.name %></h3>
                                    <p class="product-desc card-p-desc" data-en="<%= item.description %>"><%= item.description %></p>
                                </div>
                                
                                <div class="specs-list">
                                    <span class="spec-tag card-p-fabric" data-en="<%= item.fabric_type || 'Cotton' %>">Fabric: <%= item.fabric_type || 'Cotton' %></span>
                                    <span class="spec-tag card-p-gsm" data-en="<%= item.gsm_count || '120 GSM' %>">Count: <%= item.gsm_count || '120 GSM' %></span>
                                    <span class="spec-tag card-p-colors" data-en="<%= item.available_colors || 'Multiple' %>">Colors: <%= item.available_colors || 'Multiple' %></span>
                                </div>
                            </div>
                        </div>

                        <div style="padding: 0 1.25rem 1.25rem;">
                            <div class="price-row" style="margin-bottom:0.85rem;">
                                <div>
                                    <span class="price-val">₹<%= parseFloat(item.price).toFixed(2) %></span>
                                    <span class="price-type card-p-price-type" data-en="<%= (item.price_type || 'piece').replace('_', ' ') %>">/ <%= (item.price_type || 'piece').replace('_', ' ') %></span>
                                </div>
                                <span style="font-size:0.75rem; color:var(--gold); font-weight:700;" class="card-p-code">Code: <%= item.code %></span>
                            </div>

                            <button class="btn-whatsapp btn-order-ws" onclick="openOrderModal('<%= item.name %>', '<%= item.code %>', '<%= item.price %>', '<%= merchant.whatsapp %>')">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-0.999 3.648 3.742-0.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.572-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
                                <span class="ws-btn-text">Order via WhatsApp</span>
                            </button>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    </div>

    <!-- PAGE 2: JOB TRACKER VIEW -->
    <div class="page-view" id="trackerView">
        <div class="container">
            <div class="search-card">
                <h2 style="font-size:1.6rem; text-align:center; color:white;" id="trackTitle">STITCHING & GARMENT JOB TRACKER</h2>
                <p style="color:var(--text-muted); font-size:0.85rem; text-align:center;" id="trackSub">Enter your Job Ticket Number to check live stitching & delivery progress</p>
                
                <div style="display:flex; gap:0.5rem; margin-top:0.5rem;">
                    <input type="text" id="ticketInput" class="search-input" placeholder="e.g. JOB-88410" value="JOB-88410">
                    <button class="btn-whatsapp" onclick="trackJob()" style="width:auto; padding:0 1.5rem;" id="btnCheckStatus">Check Status</button>
                </div>
                <div id="errorMsg" style="color:#fca5a5; font-size:0.85rem; text-align:center; display:none;"></div>
            </div>

            <div class="search-card" id="resultCard" style="display:none; max-width:800px;">
                <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border); padding-bottom:1rem;">
                    <div>
