                                                <button onclick="updateJobStatus('<%= job.job_ticket_number %>', 'cutting')" class="btn-act-cut" style="background:var(--gold); color:black; border:none; padding:0.4rem 0.7rem; border-radius:6px; font-weight:800; cursor:pointer; font-size:0.75rem;">Mark Cutting</button>
