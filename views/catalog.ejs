    // REAL-TIME DELETE PRODUCT FROM CATALOG (NO RELOAD!)
    async function deleteProduct(productId) {
        if (!confirm('Are you sure you want to delete this design collection from catalog?')) return;

        try {
            const res = await fetch(`/api/v1/admin/products/${productId}`, {
                method: 'DELETE'
            });

            if (!res.ok) throw new Error('Failed to delete product');

            const cardEl = document.getElementById(`card-${productId}`);
            const rowEl = document.getElementById(`admin-prod-row-${productId}`);

            if (cardEl) cardEl.remove();
            if (rowEl) rowEl.remove();

            alert('Product design collection deleted from catalog successfully!');
        } catch (err) { alert(err.message); }
    }

