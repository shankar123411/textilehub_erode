                    <h3 style="font-size:1.3rem; color:var(--gold);" id="lblCatalogManageTitle">MANAGE CATALOG COLLECTIONS</h3>
                    <span style="font-size:0.8rem; color:var(--text-muted);" id="lblCatalogManageSub">Add or Delete Product Designs</span>
                </div>

                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th id="thCode">Code</th>
                                <th id="thProdName">Design / Product Name</th>
