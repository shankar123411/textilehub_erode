                                    <td><%= job.quantity %> Pcs - <%= job.garment_type %></td>
                                    <td><%= job.fabric_inward_length || 'N/A' %></td>
                                    <td><span class="tag-status <%= job.status %>" id="badge-<%= job.job_ticket_number %>"><%= job.status === 'dispatched' ? 'READY FOR DELIVERY' : (job.status || 'pending').replace('_', ' ') %></span></td>
                                    <td style="color:var(--gold); font-weight:700;"><%= job.estimated_delivery || 'TBD' %></td>
                                    <td id="act-col-<%= job.job_ticket_number %>">
