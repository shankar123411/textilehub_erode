    function openOtpModal() { document.getElementById('otpResetModal').style.display = 'flex'; }
    function closeOtpModal() { document.getElementById('otpResetModal').style.display = 'none'; }

    async function sendResetOtp() {
        const phone = document.getElementById('otpPhoneInput').value;
        const err = document.getElementById('otpErr');
        const succ = document.getElementById('otpSucc');
        err.style.display = 'none'; succ.style.display = 'none';

        try {
            const res = await fetch('/api/v1/admin/send-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ phone })
            });

            const data = await res.json();
            if (!res.ok) throw new Error(data.message || 'Failed to send OTP');

            succ.textContent = `${data.message} | OTP Code: ${data.otp}`;
            succ.style.display = 'block';

            document.getElementById('otpStep1').style.display = 'none';
            document.getElementById('otpStep2').style.display = 'flex';
        } catch (e) {
            err.textContent = e.message;
            err.style.display = 'block';
        }
    }

    async function verifyAndResetPassword() {
        const phone = document.getElementById('otpPhoneInput').value;
        const otp = document.getElementById('otpCodeInput').value;
        const newUsername = document.getElementById('otpNewUser').value;
        const newPassword = document.getElementById('otpNewPass').value;

        const err = document.getElementById('otpErr');
        const succ = document.getElementById('otpSucc');
        err.style.display = 'none'; succ.style.display = 'none';

        try {
            const res = await fetch('/api/v1/admin/verify-reset-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ phone, otp, newUsername, newPassword })
            });

            const data = await res.json();
            if (!res.ok) throw new Error(data.message || 'Verification failed');

            alert(`Credentials Reset Successful! Login with New Username: ${newUsername}`);
            closeOtpModal();
            document.getElementById('adminUser').value = newUsername;
            document.getElementById('adminPass').value = newPassword;
        } catch (e) {
            err.textContent = e.message;
            err.style.display = 'block';
        }
    }

