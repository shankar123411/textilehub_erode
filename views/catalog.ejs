    // IN-PAGE REAL-TIME STATUS UPDATE (NO PAGE RELOAD / NO LOGOUT / STAYS ON TAB 3!)
    async function updateJobStatus(ticket, nextStatus) {
        try {
            const res = await fetch(`/api/v1/admin/jobs/${ticket}/status`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: nextStatus })
            });

            if (!res.ok) throw new Error('Status update failed');

            // Update status badge on page without reloading!
            const badgeEl = document.getElementById(`badge-${ticket}`);
            const actCol = document.getElementById(`act-col-${ticket}`);

            if (badgeEl) {
                badgeEl.className = `tag-status ${nextStatus}`;
                const textLabel = nextStatus === 'dispatched' ? (currentLang === 'ta' ? 'டெலிவரிக்கு தயார்' : 'READY FOR DELIVERY') : nextStatus.replace('_', ' ');
                badgeEl.textContent = textLabel;
            }

            if (actCol) {
                if (nextStatus === 'cutting') {
                    actCol.innerHTML = `<button onclick="updateJobStatus('${ticket}', 'stitching')" class="btn-act-stitch" style="background:var(--gold); color:black; border:none; padding:0.4rem 0.7rem; border-radius:6px; font-weight:800; cursor:pointer; font-size:0.75rem;">Mark Stitching</button>`;
                } else if (nextStatus === 'stitching') {
                    actCol.innerHTML = `<button onclick="updateJobStatus('${ticket}', 'quality_check')" class="btn-act-qc" style="background:var(--gold); color:black; border:none; padding:0.4rem 0.7rem; border-radius:6px; font-weight:800; cursor:pointer; font-size:0.75rem;">Mark Product Inspection</button>`;
                } else if (nextStatus === 'quality_check') {
                    actCol.innerHTML = `<button onclick="updateJobStatus('${ticket}', 'dispatched')" class="btn-act-disp" style="background:#dc2626; color:white; border:none; padding:0.4rem 0.7rem; border-radius:6px; font-weight:800; cursor:pointer; font-size:0.75rem; box-shadow:0 0 10px var(--red-glow);">Mark Ready for Delivery</button>`;
                } else if (nextStatus === 'dispatched') {
                    actCol.innerHTML = `<span class="lbl-dispatched-tag">Ready for Delivery</span>`;
                }
            }

            alert(`Status for ${ticket} updated to: ${nextStatus.replace('_', ' ')}`);
        } catch (err) { alert(err.message); }
    }

