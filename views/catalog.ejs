                                                <button onclick="updateJobStatus('<%= job.job_ticket_number %>', 'stitching')" class="btn-act-stitch" style="background:var(--gold); color:black; border:none; padding:0.4rem 0.7rem; border-radius:6px; font-weight:800; cursor:pointer; font-size:0.75rem;">Mark Stitching</button>
                                            <% } else if(job.status === 'stitching') { %>
                                                <button onclick="updateJobStatus('<%= job.job_ticket_number %>', 'quality_check')" class="btn-act-qc" style="background:var(--gold); color:black; border:none; padding:0.4rem 0.7rem; border-radius:6px; font-weight:800; cursor:pointer; font-size:0.75rem;">Mark Product Inspection</button>
                                            <% } else if(job.status === 'quality_check' || job.status === 'packing') { %>
