<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Merchant Login - TextileHub Erode</title>
    <style>
        :root {
            --bg: #0f172a;
            --panel: #1e293b;
            --border: #334155;
            --text-main: #f8fafc;
            --brand: #0284c7;
            --gold: #f59e0b;
            --radius: 16px;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        body { background: var(--bg); color: var(--text-main); height: 100vh; display: flex; justify-content: center; align-items: center; padding: 1rem; }

        .login-card { background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); padding: 2.5rem; width: 100%; max-width: 400px; display: flex; flex-direction: column; gap: 1.5rem; box-shadow: 0 25px 50px rgba(0,0,0,0.5); }
        .login-header h1 { font-size: 1.5rem; font-weight: 800; color: #38bdf8; }
        .login-header span { color: var(--gold); }

        .form-group { display: flex; flex-direction: column; gap: 0.4rem; }
        .form-group label { font-size: 0.85rem; font-weight: 700; color: #94a3b8; }
        .form-input { padding: 0.75rem 1rem; border: 1px solid var(--border); border-radius: 8px; background: #0f172a; color: white; font-size: 0.95rem; }

        .btn-submit { background: var(--brand); color: white; border: none; padding: 0.85rem; border-radius: 8px; font-weight: 800; font-size: 1rem; cursor: pointer; }
        .btn-submit:hover { background: #0369a1; }
        .error-msg { background: #7f1d1d; color: #fca5a5; padding: 0.6rem; border-radius: 6px; font-size: 0.85rem; display: none; }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="login-header">
            <h1>🧶 TextileHub <span>Erode</span></h1>
            <p style="font-size:0.85rem; color:#94a3b8; margin-top:0.25rem;">Merchant & Production Control Panel</p>
        </div>

        <div id="errorBox" class="error-msg"></div>

        <form id="loginForm" style="display:flex; flex-direction:column; gap:1.25rem;">
            <div class="form-group">
                <label>Username</label>
                <input type="text" id="usernameInput" class="form-input" value="erode1stone" required>
            </div>
            <div class="form-group">
                <label>Password</label>
                <input type="password" id="passwordInput" class="form-input" value="mythird1" required>
            </div>
            <button type="submit" class="btn-submit">Sign In to Control Panel</button>
        </form>
    </div>

<script>
    document.getElementById('loginForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const errBox = document.getElementById('errorBox');
        errBox.style.display = 'none';

        const username = document.getElementById('usernameInput').value;
        const password = document.getElementById('passwordInput').value;

        try {
            const res = await fetch('/api/v1/admin/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username, password })
            });

            const data = await res.json();
            if (!res.ok) throw new Error(data.message || 'Invalid credentials');

            window.location.href = '/admin';
        } catch (err) {
            errBox.textContent = err.message;
            errBox.style.display = 'block';
        }
    });
</script>
</body>
</html>
